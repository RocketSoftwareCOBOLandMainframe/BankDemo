# Set the default behavior, in case people don't have core.autocrlf set.
* text=auto

# Explicitly declare text files you want to always be normalized and converted
# to native line endings on checkout.
*.c text
*.h text

# Declare files that will always have CRLF line endings on checkout.
*.sln text eol=crlf
*.cblproj text eol=crlf

# Shell scripts must keep LF endings. A Windows checkout would otherwise give
# them CRLF, and the copy then fails on Linux with a bad interpreter error.
*.sh text eol=lf

# Pinned so that the provisioning scripts are byte identical on both platforms,
# which keeps them stable when a working copy is shared between Windows and
# Linux by means other than git, such as a file copy.
*.py text eol=lf

# Denote all files that are truly binary and should not be modified.
*.dat binary
*.so binary
*.dll binary